{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SQL-coffin/interactive-guitar-lab/evaluation/schemas/annotation.schema.json",
  "title": "Guitar note-event ground-truth annotation",
  "description": "One file per recording. guitar_eval.datasets also checks: recordingId matches the manifest, onset/offset within the recording, offset > onset, string+fret consistent with the tuning, and notes inside annotatedRegions for partial annotations.",
  "type": "object",
  "required": [
    "schemaVersion",
    "recordingId",
    "completeness",
    "notes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "recordingId": {
      "type": "string"
    },
    "completeness": {
      "enum": [
        "complete",
        "partial"
      ],
      "description": "'partial' requires annotatedRegions; predictions outside them are ignored rather than counted as false positives."
    },
    "annotatedRegions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "number",
            "minimum": 0
          },
          {
            "type": "number"
          }
        ],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/note"
      }
    }
  },
  "$defs": {
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pitchMidi",
        "onsetSeconds",
        "offsetSeconds"
      ],
      "properties": {
        "pitchMidi": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "onsetSeconds": {
          "type": "number",
          "minimum": 0
        },
        "offsetSeconds": {
          "type": [
            "number",
            "null"
          ],
          "description": "null when the end is unknown or not meaningful (e.g. natural decay, ringing past the end)."
        },
        "stringNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "description": "1 = lowest-pitched string."
        },
        "fret": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36
        },
        "technique": {
          "enum": [
            "slide-in",
            "slide-out",
            "bend",
            "release",
            "hammer-on",
            "pull-off",
            "vibrato",
            "palm-mute",
            "harmonic"
          ]
        },
        "annotationConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Below the run's minReferenceConfidence (default 0.5) the note is optional: neither a hit nor a miss."
        }
      }
    }
  }
}
