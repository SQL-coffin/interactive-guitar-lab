        "conditions": { "environment": "home studio", "noise": "low", "effects": [], "notes": "Neck pickup, no amp." },
        "annotationSource": { "method": "manual", "annotator": "initials or handle", "tool": "Sonic Visualiser", "notes": "Onsets checked at 10 ms zoom." }
