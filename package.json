{
  "name": "interactive-guitar-theory-lab",
  "private": true,
  "version": "0.1.0",
  "description": "Interactive guitar music theory learning lab",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @interactive-guitar-lab/web",
    "dev": "npm run dev --workspace @interactive-guitar-lab/web",
    "build:web": "npm run build --workspace @interactive-guitar-lab/web"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
